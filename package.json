{
  "name": "tron-permission-control",
  "version": "3.0.1",
  "description": "TRON batch permission control center v3.0.1",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis portable",
    "dist:mac": "electron-builder --mac dmg zip",
    "dist:all": "electron-builder --win nsis portable --mac dmg zip",
    "check": "node scripts/check.js"
  },
  "dependencies": {
    "@tronweb3/tronwallet-adapter-imtoken": "1.2.0",
    "@tronweb3/tronwallet-adapter-tokenpocket": "1.2.0",
    "@tronweb3/tronwallet-adapter-tronlink": "1.3.0",
    "@tronweb3/tronwallet-adapter-walletconnect": "3.1.0",
    "tronweb": "6.5.1"
  },
  "devDependencies": {
    "electron": "38.2.1",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.tronpermission.control",
    "productName": "TRON Permission Control",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.finance",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
